{
  "mailboxes": [
    "http://mac-lan.example:8776",
    "http://127.0.0.1:8778"
  ],
  "island_root_url": "http://127.0.0.1:8765",
  "_comment_roots": "one dashboard can read several independent island roots; each root keeps its own pairing token file",
  "roots": [
    {
      "name": "mac",
      "url": "http://127.0.0.1:8765",
      "token_file": "~/.pandosi/pairing.token"
    },
    {
      "name": "win",
      "url": "http://win-lan.example:8790",
      "token_file": "~/.pandosi/win-pairing.token"
    }
  ],
  "sender": "mac-codex",
  "proposer_id": "mac-proposer",
  "_comment_services": "optional extra health probes; observatory only",
  "services": [
    {
      "name": "4B proxy",
      "url": "http://127.0.0.1:8080/health"
    },
    {
      "name": "teacher2 proxy",
      "url": "http://127.0.0.1:8087/health"
    }
  ],
  "_comment_think_ledgers": "optional proposer ledgers; mailbox proposal activity is always shown",
  "think_ledgers": [
    {
      "host": "mac",
      "path": "~/.pandosi/think-ledger.jsonl"
    },
    {
      "host": "pi5",
      "path": "~/.pando/think-ledger.jsonl",
      "ssh": "pi5"
    }
  ],
  "recipient": "all",
  "compose": [
    {
      "kind": "chat"
    },
    {
      "kind": "proposal",
      "signed": true,
      "action": "human.propose"
    }
  ]
}
