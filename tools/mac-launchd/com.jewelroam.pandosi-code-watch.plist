<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jewelroam.pandosi-code-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/zhengenrong/Downloads/PandoSI-island/.venv/bin/python</string>
    <string>/Users/zhengenrong/Downloads/PandoSI-island/tools/node_code_watch.py</string>
    <string>--repo</string>
    <string>/Users/zhengenrong/Downloads/PandoSI-island</string>
    <string>--peer</string>
    <string>http://127.0.0.1:8478/code.bundle</string>
    <!-- The node-local list of fallback bundles, one URL per line. The
         baked-in --peer above is the bootstrap address; this file is where a
         moved address is repaired, so the repair is a line edit and not a
         new plist on every host. -->
    <string>--peer-file</string>
    <string>/Users/zhengenrong/.pandosi/code-sources.txt</string>
    <string>--peer-token-file</string>
    <string>/Users/zhengenrong/.pandosi/mailbox.token</string>
    <string>--on-update</string>
    <string>clients</string>
    <string>--ledger</string>
    <string>/Users/zhengenrong/.pandosi/code-sync-ledger.jsonl</string>
    <!-- Keep the fallback bundle on the same HEAD as this checkout. The
         bundle is HEAD-keyed, so unchanged rounds are a no-op. -->
    <string>--bundle-cache</string>
    <string>/Users/zhengenrong/.pandosi/code.bundle</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/zhengenrong/Downloads/PandoSI-island</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- A oneshot, not a resident loop: the updater has to load the updater
       code it just pulled. StartInterval keeps it outside the client roster
       so it never restarts itself. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/zhengenrong/.pandosi/logs/code-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zhengenrong/.pandosi/logs/code-watch.log</string>
</dict>
</plist>
