<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac's resident decision model (Laya INT8, ONNX CPU) as a launchd agent.

  Why this file exists: until 2026-10-18 the Mac's only voter was mac-text, a
  naive-Bayes stance classifier that answered "赞同" to 56 of 56 proposals --
  a voter with one opinion is a rubber stamp, not a decision. Laya is the only
  backend on this fleet that has produced all three stances, so the Mac needs
  one to have a real vote.

  The weights are NOT in git and never will be; they live under
  ~/.pandosi/models/ and are copied device-to-device. See the sha256 below --
  it must match the pi5 and win copies or the three are not the same voter.

  Install (paths are user-specific; edit the /Users/<you> roots):
    cp tools/mac-launchd/com.pandosi.stem.laya.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pandosi.stem.laya.plist
  Inspect:
    launchctl list | grep stem.laya
    curl -s http://127.0.0.1:8769/health
  Roll back (this is a memory-tight 16 GB box; keep the command handy):
    launchctl bootout gui/$(id -u)/com.pandosi.stem.laya
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pandosi.stem.laya</string>
  <key>ProgramArguments</key><array>
    <string>/Users/zhengenrong/Downloads/PandoSI-island/.venv/bin/python</string>
    <string>-m</string><string>pando.worker</string>
    <string>--node-id</string><string>mac-laya-int8</string>
    <string>--checkpoint</string><string>laya-en</string>
    <string>--backend</string><string>onnx</string>
    <string>--onnx-path</string><string>/Users/zhengenrong/.pandosi/models/laya-en.int8.onnx</string>
    <string>--repo</string><string>/Users/zhengenrong/.pandosi/models/laya-repo</string>
    <string>--role</string><string>decision</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8769</string>
    <string>--root</string><string>http://127.0.0.1:8765</string>
    <string>--pairing-token-file</string><string>/Users/zhengenrong/.pandosi/pairing.token</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/zhengenrong/Downloads/PandoSI-island</string>
  <key>EnvironmentVariables</key><dict>
    <key>HF_HUB_OFFLINE</key><string>1</string>
    <key>TRANSFORMERS_OFFLINE</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/zhengenrong/.pandosi/logs/stem-laya.log</string>
  <key>StandardErrorPath</key><string>/Users/zhengenrong/.pandosi/logs/stem-laya.log</string>
</dict></plist>
