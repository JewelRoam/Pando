[Unit]
Description=PandoSI pi5 member: text-nb-v1 (naive Bayes)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin
ExecStart=/home/admin/pando/bin/python -m pando.worker --node-id pandosi-pi5-x --backend text --checkpoint text-nb-v1 --root http://127.0.0.1:8791 --pairing-token-file /home/admin/.pando/root-pairing.token --host 0.0.0.0 --advertise-host 192.168.31.22
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
