[Unit]
Description=PandoSI pi5 resident proposer: the thought loop that does not wait to be asked
After=network-online.target pandosi-llama.service
Wants=pandosi-llama.service

[Service]
Type=simple
WorkingDirectory=/home/admin
ExecStart=/home/admin/pando/bin/python -m pando.thinkd --node-id pi5-proposer --base-url http://127.0.0.1:8085/v1 --model qwen3-1.7b --mailbox http://192.168.31.41:8776 --token-file /home/admin/.pando/mailbox.token --ledger /home/admin/.pando/think-ledger.jsonl --interval 180 --explore-every 5 --activity-every 4
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
