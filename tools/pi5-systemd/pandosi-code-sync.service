[Unit]
Description=Fast-forward the PandoSI checkout
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/admin/pando/bin/python /home/admin/.pandosi/code_sync.py --repo /home/admin/pandosi-src --peer http://192.168.31.41:8478/code.bundle --peer-token-file /home/admin/.pando/mailbox.token --install-python /home/admin/pando/bin/python --restart pandosi-think.service --restart pandosi-chat.service --restart pandosi-seed-pull.service --restart pandosi-react.service
