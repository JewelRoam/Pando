Type=oneshot
ExecStart=/home/admin/pando/bin/python /home/admin/.pandosi/code_sync.py --repo /home/admin/pandosi-src --peer http://192.168.31.100:8778/code.bundle --peer http://100.93.216.90:8778/code.bundle --peer-file /home/admin/.pando/code-sources.txt --peer-token-file /home/admin/.pando/mailbox.token --self-source /home/admin/pandosi-src/tools/code_sync.py --self-target /home/admin/.pandosi/code_sync.py --install-units /home/admin/pandosi-src/tools/pi5-systemd --install-units-target /home/admin/.config/systemd/user --install-python /home/admin/pando/bin/python --restart pandosi-think.service --restart pandosi-chat.service --restart pandosi-seed-pull.service --restart pandosi-react.service --restart pandosi-execute.service --restart pandosi-stem-text.service --restart pandosi-stem-laya.service --restart pandosi-stem-llm.service --telemetry-url http://100.92.184.4:8776/telemetry/pi5 --telemetry-token-file /home/admin/.pando/mailbox.token --telemetry-root-url http://127.0.0.1:8791 --telemetry-root-token-file /home/admin/.pando/root-pairing.token --telemetry-identity /home/admin/.pando/identity.json --telemetry-think-ledger /home/admin/.pando/think-ledger.jsonl
