[Unit]
Description=PandoSI pi5 member: Laya int8 decision model
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin
ExecStart=/home/admin/pando/bin/python -m pando.stemd --node-id pandosi-pi5-laya --backend onnx --onnx-path /home/admin/models/laya-en.int8.onnx --repo /home/admin/models/laya-repo --checkpoint laya-en --root http://127.0.0.1:8791 --pairing-token-file /home/admin/.pando/root-pairing.token --host 0.0.0.0 --advertise-host 192.168.31.22
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
