[Unit]
Description=PandoSI pi5 executor: acts on adopted proposals this host signed
After=network-online.target pandosi-root.service
Wants=pandosi-root.service

[Service]
# Not a timer: the roster's rule is that no host gains a new scheduled task,
# so this process is the clock. 600s is measured, not guessed -- one round on
# this 4 GB board takes ~70s (the reaction fetch is one GET per row, and the
# mailbox is on the Mac over LAN), so 600s keeps the duty cycle around a tenth
# of a core instead of a quarter. The Mac runs the same job on the same
# cadence from launchd.
Type=simple
WorkingDirectory=/home/admin
ExecStart=/home/admin/pando/bin/python /home/admin/pandosi-src/tools/execute_loop.py 600 --repo /home/admin/pandosi-src --hosts /home/admin/.pando/hosts.json --state-dir /home/admin/.pando --token-file /home/admin/.pando/mailbox.token --mailbox http://192.168.31.41:8776 --mailbox-fallback http://192.168.31.100:8778 --limit 40
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
